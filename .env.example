# OSM OAuth2 credentials (register at https://www.openstreetmap.org/oauth2/applications)
VITE_OSM_CLIENT_ID=your_client_id_here
VITE_OSM_CLIENT_SECRET=your_client_secret_here
VITE_OSM_REDIRECT_URI=http://127.0.0.1:8088/callback

# Production overrides (set in CI/deploy)
# VITE_OSM_REDIRECT_URI=https://surway.hovland.co/callback